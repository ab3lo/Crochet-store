{
  "name": "@crochet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun scripts/migrate.ts",
    "auth:migrate": "echo 'Better Auth tables are created by 0002_better_auth.sql — run db:migrate'",
    "seed": "bun scripts/seed.ts",
    "create-admin": "bun scripts/create-admin.ts"
  },
  "dependencies": {
    "@crochet/shared": "workspace:*",
    "@hono/zod-validator": "^0.7.2",
    "better-auth": "~1.4.22",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
