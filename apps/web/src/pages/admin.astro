---
/**
 * Admin panel entry.
 *
 * A static page like every other one — the storefront host serves it, the
 * API does the auth. Nothing here is secret: the guard lives in the API
 * (`/api/admin/*`), and this page simply hides the UI until it knows who
 * is signed in.
 */

import Base from '@/layouts/Base.astro';
import AdminApp from '@/components/admin/AdminApp.svelte';
import { hasApi, config } from '@/lib/config';
---

<Base
  title="Shop admin — Crochet & Co."
  description="Manage the catalogue, promotions and custom orders."
  noindex
  bare
>
  <AdminApp hasApi={hasApi} apiUrl={config.apiUrl} client:only="svelte" />
</Base>

<style is:global>
  /* The admin is a tool, not a shopfront. It gets the same palette but a
     denser, flatter treatment with no storefront chrome. */
  body.is-bare { background: var(--color-shell); }
</style>
