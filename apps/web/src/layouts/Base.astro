---
/**
 * Document shell. Everything else renders inside <slot />.
 *
 * `data-theme="blush"` on <html> is what activates the theme; the value
 * must match the selector in `styles/theme-blush.css`.
 */

import '@/styles/global.css';
import { absolute } from '@/lib/config';

interface Props {
  title: string;
  description: string;
  /** Used for the og:image and the JSON-LD. Defaults to the social card. */
  image?: string;
  /** Keep search engines away (admin, previews). */
  noindex?: boolean;
  /** Minimal pages (admin) skip the storefront chrome. */
  bare?: boolean;
}

const { title, description, image, noindex = false, bare = false } = Astro.props;

const canonical = absolute(Astro.url.pathname);
const ogImage = absolute(image ?? '/images/og-default.svg');
---

<!doctype html>
<html lang="en" data-theme="blush">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Crochet & Co." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBF4F2" />

    {/* Fraunces is the display face; preload so the hero does not reflow.
        Same file the stylesheet references, so the fetch is deduped. */}
    <link
      rel="preload"
      href="/fonts/fraunces.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class:list={[bare && 'is-bare']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <!--
      The "hide a dismissed banner before it flashes" script used to live here,
      inline, and it was dead code: it set `data-banner-dismissed` on <html>,
      and nothing ever read that attribute — no stylesheet, no component. The
      dismissal is applied inside BannerRail, which filters the list once it
      hydrates. Deleting it also removed the last inline script on the page,
      which matters because `is:inline` opts a script out of Astro's CSP
      hashing, so it was the one thing `script-src` could not account for.
    -->
  </body>
</html>
