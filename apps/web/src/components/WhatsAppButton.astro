---
/**
 * Floating WhatsApp button.
 *
 * Static markup plus CSS — no island, no JavaScript. It is a link; making it
 * a hydrated component would ship a runtime for something the browser
 * already does.
 *
 * The mark is inline SVG rather than a font or an image request: no extra
 * network request, and it inherits `currentColor` so the button's palette
 * lives in CSS.
 */

import { contact, whatsappUrl } from '@/lib/contact';

const href = whatsappUrl();
---

<a
  class="wa"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Message ${contact.whatsapp} on WhatsApp`}
  data-testid="whatsapp-button"
>
  <svg class="wa-mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <path
      fill="currentColor"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24m-2.6 4.2c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.32 1.03 2.48c.13.16 1.76 2.69 4.27 3.77.6.26 1.06.41 1.43.52.6.19 1.15.16 1.58.1.48-.07 1.48-.6 1.69-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.28-.25-.13-1.48-.73-1.71-.81-.23-.09-.4-.13-.56.12-.17.25-.65.81-.79.98-.15.16-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.55-.43h-.47"
    ></path>
  </svg>

  <span class="wa-label">WhatsApp me</span>
</a>

<style>
  .wa {
    position: fixed;
    z-index: 50;
    right: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.95rem;
    border-radius: 999px;

    /* The shop's deep rose rather than WhatsApp green — it has to sit in
       this palette, and a saturated green block in the corner of a blush
       page reads as a sticker somebody pasted on. The mark still says
       WhatsApp; the button says Crochet & Co. */
    background: var(--color-rose-deep);
    color: #fff;
    border: 1.5px solid var(--color-ink);
    box-shadow: 3px 3px 0 color-mix(in oklab, var(--color-ink) 22%, transparent);

    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 140ms ease, box-shadow 140ms ease, background-color 140ms ease;
  }

  .wa:hover {
    background: color-mix(in oklab, var(--color-rose-deep) 88%, #000);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 color-mix(in oklab, var(--color-ink) 26%, transparent);
  }

  .wa:active {
    transform: translate(0, 0);
    box-shadow: 1px 1px 0 color-mix(in oklab, var(--color-ink) 22%, transparent);
  }

  .wa-mark { flex-shrink: 0; }

  /* Circle on a phone: the label would cover the content underneath. */
  .wa-label { display: none; }

  @media (min-width: 640px) {
    .wa-label { display: inline; }
  }

  /* Give the footer room so the button never sits on top of a link. */
  @media (max-width: 639px) {
    .wa { padding: 0.85rem; }
  }
</style>
