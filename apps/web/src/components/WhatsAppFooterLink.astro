---
/**
 * WhatsApp link for the footer column.
 *
 * Sits directly under the community invite and is the same `.pill` as it, in
 * the same block, so it is exactly the same width at every breakpoint without
 * a line of measurement. That is the whole trick: the floating button does
 * not move here, it is replaced by this one, and "sized relative to the
 * community CTA" falls out of the layout rather than out of arithmetic.
 *
 * It is hidden until the footer is reached, at which point the floating
 * button stands down — see the observer in `Footer.astro`.
 */

import { contact, whatsappUrl } from '@/lib/contact';

const href = whatsappUrl();
---

<a
  class="wa-footer pill btn-stitch"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Message ${contact.whatsapp} on WhatsApp`}
  data-testid="whatsapp-footer-link"
>
  <svg class="mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      fill="currentColor"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24m-2.6 4.2c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.32 1.03 2.48c.13.16 1.76 2.69 4.27 3.77.6.26 1.06.41 1.43.52.6.19 1.15.16 1.58.1.48-.07 1.48-.6 1.69-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.28-.25-.13-1.48-.73-1.71-.81-.23-.09-.4-.13-.56.12-.17.25-.65.81-.79.98-.15.16-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.55-.43h-.47"
    ></path>
  </svg>

  <span>WhatsApp me</span>
</a>

<style>
  /* The floating button's palette, so WhatsApp reads as one channel. */
  .wa-footer {
    margin-top: 0.5rem;
    background: var(--color-rose-deep);
    border-color: var(--color-ink);
    color: #fff;

    /* Hidden until the footer is reached. It is in the flow either way, so
       revealing it costs no layout shift and the footer does not resize
       under the reader — only opacity and a small rise move.

       The reveal lives here rather than in `Footer.astro` because Astro
       scopes a rule to the component that renders the element. A class handed
       down from the parent lands on an element carrying the *child's* scope
       id, so the parent's `.dock` rule silently matched nothing. */
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html[data-footer-visible]) .wa-footer {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .wa-footer:hover {
    background: color-mix(in oklab, var(--color-rose-deep) 88%, #000);
    box-shadow: 3px 3px 0 color-mix(in oklab, var(--color-ink) 22%, transparent);
  }

  .mark { flex-shrink: 0; }

  @media (prefers-reduced-motion: reduce) {
    .wa-footer { transition: opacity 160ms ease; transform: none; }
  }
</style>
