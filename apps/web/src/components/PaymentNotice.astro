---
/**
 * Payment-terms notice.
 *
 * The companion to `RegionNotice`. That one says *where* the shop is; this
 * says *how an order gets paid for*, which is the other thing a shopper needs
 * before they fill a basket rather than after they have been surprised.
 *
 * Shown on the shipping page, every product page and in the basket, because
 * the terms are the same everywhere — which is exactly why the wording is
 * not written here. It is `PAYMENT_TERMS` in `@crochet/shared`, so the
 * percentage and the wallets can be changed in one place.
 */

import { PAYMENT_TERMS } from '@crochet/shared';

interface Props {
  /** `inline` is a single line for tight spots; `panel` is the full notice. */
  variant?: 'panel' | 'inline';
}

const { variant = 'panel' } = Astro.props;
---

{
  variant === 'inline' ? (
    <span class="inline">
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
        <rect
          x="2.5"
          y="3.5"
          width="11"
          height="9"
          rx="1.6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"></rect>
        <path d="M2.5 6.5h11" fill="none" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
      {PAYMENT_TERMS.short}
    </span>
  ) : (
    <p class="pay">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <rect
          x="2.5"
          y="3.5"
          width="11"
          height="9"
          rx="1.6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"></rect>
        <path d="M2.5 6.5h11" fill="none" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
      <span>
        <strong>{PAYMENT_TERMS.headline}</strong> {PAYMENT_TERMS.detail}
      </span>
    </p>
  )
}

<style>
  /* Deliberately the same shape as RegionNotice's panel — a dashed edge in the
     blush tint — so the two read as one set of terms on a product page rather
     than as two competing boxes. */
  .pay {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--color-blush) 30%, var(--color-paper));
    border: 1.5px dashed color-mix(in oklab, var(--color-rose) 35%, transparent);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .pay svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--color-rose-deep);
  }

  .pay strong { color: var(--color-ink); }

  .inline {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-rose-deep);
  }
</style>
