---
/**
 * Footer. Small, and useful rather than a link farm: what the shop makes,
 * how to order, and how to reach a person.
 */

import CommunityLink from '@/components/CommunityLink.astro';
import WhatsAppFooterLink from '@/components/WhatsAppFooterLink.astro';
import { contact, communityUrl } from '@/lib/contact';
import { FOOTER_SHOP_LINKS, SITE_INFORMATION_LINKS } from '@/lib/navigation';

const year = new Date().getFullYear();
---

<script>
  /**
   * Hand the corner over to the footer.
   *
   * When the footer comes into view the floating button would sit on top of
   * the links it is meant to sit beside, so it stands down and the footer's
   * own WhatsApp button — already the same size, already in the column —
   * takes over. Scrolling back up reverses it.
   *
   * The trigger is the replacement button, not the footer. The footer is the
   * last thing on the page and its height varies with the column count, so
   * watching the footer means the handover lands at a different scroll
   * position on every breakpoint. Watching the button that has to take over
   * means the corner leaves exactly when its replacement arrives, and there
   * is no dead zone where neither is on screen.
   *
   * One observer, one attribute, no geometry. The attribute is on <html> so
   * both components can be styled from it regardless of where they sit in
   * the document.
   */
  const handover = document.querySelector('.wa-footer');

  if (handover) {
    const observer = new IntersectionObserver(([entry]) => {
      document.documentElement.toggleAttribute('data-footer-visible', entry.isIntersecting);
    });
    observer.observe(handover);
  }
</script>

<footer class="site-footer">
  <div class="shell shell--wide footer-grid">
    <div class="footer-brand">
      <p class="footer-mark">Crochet &amp; Co.</p>
      <p class="footer-note">
        Everything here is worked by hand, in small numbers, by one person with a
        basket of yarn and too many hooks.
      </p>
    </div>

    <nav class="footer-col" aria-label="Shop">
      <h2 class="footer-head">Shop</h2>
      <ul>
        {FOOTER_SHOP_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Information">
      <h2 class="footer-head">Information</h2>
      <ul>
        {SITE_INFORMATION_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li><a href="/admin/">Shop owner sign-in</a></li>
      </ul>
    </nav>

    <div class="footer-col footer-news">
      <h2 class="footer-head">Work in progress</h2>
      <p class="footer-note">
        Whatever is on the hook this week, photographed as I go. Join the group
        and you see it before it reaches the shop.
      </p>
      <CommunityLink />
      <!--
        The floating button's counterpart. Same `.pill`, same column, so it is
        the same width as the button above it at every breakpoint without
        measuring anything. It is revealed when the footer is reached, at
        which point the floating button stands down — so there is only ever
        one WhatsApp button on screen.
      -->
      <WhatsAppFooterLink />
    </div>
  </div>

  <div class="shell shell--wide chain-rule chain-rule--tight" aria-hidden="true"></div>

  <div class="shell shell--wide footer-base">
    <p>© {year} Crochet &amp; Co. Made slowly.</p>
    <p>Built with Astro, Svelte, Hono and better-auth.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: color-mix(in oklab, var(--color-blush) 32%, var(--color-shell));
    padding-block: 3rem 2rem;
  }

  .footer-grid {
    display: grid;
    gap: 2.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .footer-grid { grid-template-columns: 1.6fr 1fr 1fr 1.5fr; gap: 2rem; }
  }

  .footer-mark {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 30, 'WONK' 1, 'opsz' 24;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .footer-note {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 30ch;
  }

  .footer-head {
    margin: 0 0 0.7rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  /* An uppercase label is right here — a column heading in a footer is
     structural navigation, not a decorative eyebrow over a heading. */
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .footer-col a {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--color-rose-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-news .footer-note { margin-bottom: 0.85rem; }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-top: 1.25rem;
  }

  .footer-base p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-ink-faint);
  }
</style>
