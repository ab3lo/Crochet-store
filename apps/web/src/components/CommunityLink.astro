---
/**
 * WhatsApp community invite — the footer's "stay in the loop" control.
 *
 * Static markup plus CSS, no island, no JavaScript. It is a link; the browser
 * already knows how to follow one, and a hydrated island here would ship a
 * runtime to collect an address this shop no longer collects. Same reasoning
 * as `WhatsAppButton.astro`.
 *
 * The pill metrics are the newsletter row's that this replaced — same 999px
 * radius, same 0.88rem type, same 1.5px border — so swapping an email field
 * for a link did not change the shape of the footer column.
 */

import { contact, communityUrl } from '@/lib/contact';

const href = communityUrl();
---

<a
  class="community pill btn-stitch"
  id="community-cta"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Join ${contact.communityName} on WhatsApp for work in progress updates`}
  data-testid="community-link"
>
  <!-- The same mark the floating button uses, so WhatsApp reads as one
       channel wherever it appears rather than three separate ideas. -->
  <svg class="mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      fill="currentColor"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24m-2.6 4.2c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.32 1.03 2.48c.13.16 1.76 2.69 4.27 3.77.6.26 1.06.41 1.43.52.6.19 1.15.16 1.58.1.48-.07 1.48-.6 1.69-1.19.21-.58.21-1.08.15-1.19-.06-.1-.23-.16-.48-.28-.25-.13-1.48-.73-1.71-.81-.23-.09-.4-.13-.56.12-.17.25-.65.81-.79.98-.15.16-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.55-.43h-.47"
    ></path>
  </svg>

  <span>Join {contact.communityName}</span>
</a>

<style>
  /* Size comes from the shared `.pill` rule in global.css, which the
     WhatsApp link below it in the footer also uses. Only the icon needs
     protecting from flex shrink. */
  .mark { flex-shrink: 0; }
</style>
