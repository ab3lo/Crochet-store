node_modules/
dist/
.astro/
.output/
.wrangler/

# SvelteKit's generated tree for the admin panel (apps/admin/.svelte-kit).
#
# Deleting it to "clear a cache" breaks the dev server outright: SvelteKit
# generates its server entrypoints there at `svelte-kit sync` time, and Vite
# resolves `/.svelte-kit/generated/server/internal.js` on the very first
# request. The error it produces —
#
#   Failed to load url /.svelte-kit/generated/server/internal.js
#
# — reads like a missing dependency and is not one. `bun run dev` runs the sync
# itself; only reach for `bunx svelte-kit sync` if it is missing at startup.
.svelte-kit/

# env
#
# The old rules only covered `.env`, `.env.local` and `.env.*.local`, which
# left `.env.production`, `.env.staging` and `.env.development` free to be
# committed. This repository is public, so a real deployment env file is the
# one file that must never be pushed. Ignore every variant, then re-admit the
# single documented template.
.env
.env.*
!.env.example

# Keys, certs and anything else credential-shaped. A deploy that needs one of
# these should read it from the platform's secret store, not the repo.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
.netrc
.npmrc
.pgpass

# Cloudflare / wrangler auth state
.dev.vars
.dev.vars.*
.mf/


# local data
# SQLite, and the two sidecar files it creates in WAL mode.
#
# `*.sqlite` alone is not enough: WAL mode writes `catalog.sqlite-wal` and
# `catalog.sqlite-shm` alongside the database, and neither matches that pattern.
# A migration commit picked all four up before these lines existed, which put
# two binary blobs in the history — and a stale `.sqlite-wal` restored from git
# is a corrupt database, not just a large one.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
*.db-wal
*.db-shm

# Generated from the committed catalogue, so it is a build artefact rather than
# source. Re-create it with `bun run catalog:whatsapp` whenever products change.
*.csv

# logs
*.log
npm-debug.log*
bun-debug.log*

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
