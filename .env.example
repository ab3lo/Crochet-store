# ─────────────────────────────────────────────────────────────
# Storefront (apps/web) — build-time + runtime public config.
# These get inlined into the static bundle: only PUBLIC_* is safe.
# ─────────────────────────────────────────────────────────────

# Public origin of the storefront (used for canonical URLs + sitemap).
PUBLIC_SITE_URL="https://crochet-and-co.pages.dev"

# Base URL of the Bun + Hono API. Leave empty to bake the local
# seed snapshot only (site still works fully offline).
PUBLIC_API_URL="http://localhost:8787"

# Where Better Auth should send unauthenticated browser requests.
# Only needed when the admin panel is on a different origin than the API.
PUBLIC_AUTH_URL="http://localhost:4321"

# ─────────────────────────────────────────────────────────────
# API (apps/api) — server only. NEVER prefix these with PUBLIC_.
# ─────────────────────────────────────────────────────────────

PORT=8787
NODE_ENV=development

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8787"
# Comma-separated list of extra trusted origins (your storefront).
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:4321"

# Supabase Postgres (pooled connection string from the dashboard)
DATABASE_URL=""

# Supabase Storage (service role: bypasses RLS, server-side only)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# ─────────────────────────────────────────────────────────────
# Seed / bootstrap
# ─────────────────────────────────────────────────────────────
# Email that gets promoted to role=admin on first sign-up.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD=""
