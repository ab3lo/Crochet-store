# ─────────────────────────────────────────────────────────────
# Storefront (apps/web) — build-time + runtime public config.
# These get inlined into the static bundle: only PUBLIC_* is safe.
# ─────────────────────────────────────────────────────────────

# Public origin of the storefront (used for canonical URLs + sitemap).
PUBLIC_SITE_URL="https://crochet-and-co.pages.dev"

# Base URL of the Bun + Hono API. Leave empty to bake the local
# seed snapshot only (site still works fully offline).
PUBLIC_API_URL="http://localhost:8787"

# Where Better Auth should send unauthenticated browser requests.
# Only needed when the admin panel is on a different origin than the API.
PUBLIC_AUTH_URL="http://localhost:4321"

# ─────────────────────────────────────────────────────────────
# API (apps/api) — server only. NEVER prefix these with PUBLIC_.
# ─────────────────────────────────────────────────────────────

PORT=8787
NODE_ENV=development

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8787"
# Comma-separated list of extra trusted origins (your storefront).
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:4321"

# Supabase Postgres (pooled connection string from the dashboard).
# Use user `postgres`, not `postgres.<ref>`: the pooler role does not own the
# tables and does not bypass RLS, so it would return zero rows with no error.
DATABASE_URL=""

# Supabase Storage (elevated access: bypasses RLS, server-side only).
# Cloudflare R2 is the better long-term host for images — its egress is free
# and unmetered, where this free plan allows 5 GB/month and then bills
# $0.09/GB — but R2 requires a payment method on the Cloudflare account, which
# is not a trade worth making at this size. Move to it if image traffic grows.
SUPABASE_URL="https://bmzzbsohlfguntalfgaf.supabase.co"
# Dashboard → Settings → API Keys → "Create new key" → Secret.
#
# Use a secret key (`sb_secret_...`), not the legacy `service_role` JWT: the
# long `eyJ...` keys are deprecated and are due to be switched off at the end
# of 2026. The name of this variable is historical — it holds either format,
# and `@supabase/supabase-js` treats them the same way.
#
# This key is full read/write on every table, so it stays server-side. Supabase
# also rejects it outright when it sees a browser User-Agent, which is a useful
# backstop but not a reason to paste it into a client bundle.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# ─────────────────────────────────────────────────────────────
# Seed / bootstrap
# ─────────────────────────────────────────────────────────────
# Email that gets promoted to role=admin on first sign-up.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD=""
